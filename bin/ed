#!/usr/bin/env python3
# ed F A-B NEW [A-B NEW]... : replace inclusive lines A..B with NEW (\n = newline). B=A-1 inserts before A; NEW='' deletes.
# Multiple pairs all refer to ORIGINAL line numbers (applied bottom-up).
import sys
f=sys.argv[1]; a=sys.argv[2:]
if len(a)%2: sys.exit('need pairs')
L=open(f).read().split('\n'); ps=[]
for i in range(0,len(a),2):
    x,y=map(int,a[i].split('-')); ps.append((x,y,a[i+1].replace('\\n','\n')))
for x,y,n in sorted(ps,reverse=True): L[x-1:y]=([] if n=='' else n.split('\n'))
open(f,'w').write('\n'.join(L)); print('ok',len(ps))
